# ── Environment / secrets ─────────────────────────────────────────────────────
# .env files contain local config (DATABASE_URL, JWT_SECRET, API keys).
# Keep .env.example (safe template) but never commit real .env files.
.env
.env.local
.env.production
.env.staging
# Exception: keep the example template
!.env.example

