# Database
DATABASE_URL=postgresql://marketpulse:marketpulse@localhost:5432/marketpulse

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Market Data (optional - leave empty to use demo mode)
MARKET_API_KEY=
NEWS_API_KEY=

# LLM (optional - leave empty to use template-based explanations)
LLM_API_KEY=
LLM_PROVIDER=openai

# App
ENVIRONMENT=development
DEMO_MODE=true

# Frontend
VITE_API_URL=http://localhost:8000
