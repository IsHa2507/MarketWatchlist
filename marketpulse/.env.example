# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL for production; SQLite for local dev
DATABASE_URL=postgresql://marketpulse:marketpulse@localhost:5432/marketpulse
# Local dev alternative:
# DATABASE_URL=sqlite:///./marketpulse.db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Market Data ───────────────────────────────────────────────────────────────
# "yahoo"  → real data via yfinance (delayed ~15 min, free, no API key needed)
# "demo"   → offline seeded data (always works, good for local/CI)
MARKET_DATA_PROVIDER=yahoo

# Cache TTL in seconds. Snapshots younger than this are served from DB.
# Increase to reduce yfinance calls; decrease for fresher data.
MARKET_CACHE_TTL_SECONDS=300

# ── News (optional) ───────────────────────────────────────────────────────────
# Free tier: 100 requests/day at newsapi.org
# Leave empty — dashboard works fine without news.
NEWS_API_KEY=

# ── Phase 2: News + Sentiment ─────────────────────────────────────────────────
# Master switch — set to false to disable all RSS news fetching entirely.
# When false, sentiment is always "Unavailable" and the 20% weight is
# redistributed to price/volume/volatility/technical.
NEWS_ENABLED=true

# How long to cache fetched headlines in the DB (seconds). Default: 3600 = 1 hour.
# Increase to reduce outbound RSS requests; decrease for fresher sentiment.
NEWS_CACHE_TTL_SECONDS=3600

# Maximum number of headlines to fetch per ticker per news refresh.
NEWS_MAX_ARTICLES=10

# Sentiment analysis method.
# "vader"   → VADER lexicon/rule-based analyser (recommended, no model download).
#             VADER is NOT a machine-learning model. It uses a curated word list
#             and grammatical rules. Requires: vaderSentiment package (installed).
# "keyword" → zero-dependency keyword heuristic (pure Python, always available).
# Future:   → "finbert" will be added in Phase 3 for financial-domain NLP.
SENTIMENT_MODEL=vader

# ── LLM explanations (optional) ──────────────────────────────────────────────
# Leave empty to use deterministic template explanations (no AI required).
# Supports OpenAI-compatible endpoints (OpenAI, Ollama via openai-compat, etc.)
LLM_API_KEY=
LLM_PROVIDER=openai

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEMO_MODE=false

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
