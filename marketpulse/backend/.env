# Database — using SQLite for local dev (no PostgreSQL needed)
DATABASE_URL=sqlite:///./marketpulse.db

# JWT
JWT_SECRET=marketpulse-local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Market Data (leave empty = demo mode)
MARKET_API_KEY=
NEWS_API_KEY=

# LLM (leave empty = template-based explanations)
LLM_API_KEY=
LLM_PROVIDER=openai

# App
ENVIRONMENT=development
DEMO_MODE=true
