# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local dev (no PostgreSQL required)
DATABASE_URL=sqlite:///./marketpulse.db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=marketpulse-local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Market Data ───────────────────────────────────────────────────────────────
# Set to "yahoo" to use real yfinance data.
# Set to "demo" to use offline seeded data (default, no API key needed).
MARKET_DATA_PROVIDER=demo

# Cache TTL in seconds (default 300 = 5 minutes).
# Data younger than this is served from the StockSnapshot table.
MARKET_CACHE_TTL_SECONDS=300

# Kept for legacy reference — not required for yahoo/demo providers
MARKET_API_KEY=

# ── News (optional) ───────────────────────────────────────────────────────────
# Leave empty to disable news fetching. Dashboard still works without it.
NEWS_API_KEY=

# ── Phase 2: News + Sentiment ─────────────────────────────────────────────────
# Master switch. Set to false to disable all RSS news fetching.
NEWS_ENABLED=true

# How long to cache news headlines in seconds (default 3600 = 1 hour).
NEWS_CACHE_TTL_SECONDS=3600

# Max headlines to fetch per ticker per request.
NEWS_MAX_ARTICLES=10

# Sentiment model: "vader" (lexicon/rule-based, recommended) or "keyword" (fallback).
# VADER is NOT a machine-learning model. It uses a curated word list + rules.
# Future: set to "finbert" when Phase 3 is implemented.
SENTIMENT_MODEL=vader

# ── LLM explanations (optional) ──────────────────────────────────────────────
# Leave empty to use template-based explanations (always available).
LLM_API_KEY=
LLM_PROVIDER=openai

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEMO_MODE=true
